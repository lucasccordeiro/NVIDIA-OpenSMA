// Thin <algorithm> shim for ESBMC verification.
// Tracks: ESBMC bundled <algorithm> lacks std::clamp (C++17/20). This shim
// includes the bundled header and adds the missing template.
#pragma once
#include_next <algorithm>

namespace std {

// Return by value — returning const T& to a local argument can cause ESBMC to
// lose the materialized result when the caller function returns (use-after-scope
// in the GOTO IR).  By-value return forces a concrete assignment.
template <class T>
constexpr T clamp(const T& v, const T& lo, const T& hi)
{
    if (v < lo) return lo;
    if (hi < v) return hi;
    return v;
}

}  // namespace std
