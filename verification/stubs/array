// Minimal std::array shim for ESBMC verification.
// Tracks: esbmc#4183 (gen_vptr_initializations crash on std::array
// instantiation; split out from the original esbmc#4180 Bug 1).
// Using ::size_t in template params triggered a separate conversion error
// at the time this shim was written, so we use unsigned long directly.
#pragma once

namespace std {

template <typename T, unsigned long N>
struct array
{
    T elems[N];

    constexpr T*            data() noexcept { return elems; }
    constexpr const T*      data() const noexcept { return elems; }
    constexpr unsigned long size() const noexcept { return N; }
    constexpr T&            operator[](unsigned long i) noexcept { return elems[i]; }
    constexpr const T&      operator[](unsigned long i) const noexcept { return elems[i]; }

    // at() asserts bounds via __ESBMC_assert so OOB access surfaces as a
    // property violation instead of a real exception (production code relies
    // on the throw to propagate; we report it as a verification failure).
    constexpr T& at(unsigned long i) noexcept
    {
        __ESBMC_assert(i < N, "std::array::at out of range");
        return elems[i];
    }
    constexpr const T& at(unsigned long i) const noexcept
    {
        __ESBMC_assert(i < N, "std::array::at out of range");
        return elems[i];
    }
};

}  // namespace std
