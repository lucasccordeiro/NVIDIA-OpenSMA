// Minimal std::array shim for ESBMC verification.
//
// Tracks: esbmc#4190 (bundled <array> is implemented as a class with no
// user-accessible aggregate-init constructor; aggregate initialisation
// `std::array<T, N>{a, b, c}` — which OpenSMA uses in
// pdk-mctp-platforms-config.h for the SupportedType table — fails to
// parse against the bundled header).
//
// The earlier reason for this shim (esbmc#4183, gen_vptr_initializations
// crash on std::array<T,N>) was fixed by esbmc/esbmc#4188 on 2026-04-26.
// The aggregate-init divergence is what keeps the shim necessary now.
//
// Using ::size_t in template params triggered a separate conversion error
// at the time this shim was first written, so we use unsigned long directly.
#pragma once

namespace std {

template <typename T, unsigned long N>
struct array
{
    T elems[N];

    constexpr T*            data() noexcept { return elems; }
    constexpr const T*      data() const noexcept { return elems; }
    constexpr unsigned long size() const noexcept { return N; }
    constexpr bool          empty() const noexcept { return N == 0; }
    constexpr T*            begin() noexcept { return elems; }
    constexpr const T*      begin() const noexcept { return elems; }
    constexpr T*            end() noexcept { return elems + N; }
    constexpr const T*      end() const noexcept { return elems + N; }
    constexpr T&            operator[](unsigned long i) noexcept { return elems[i]; }
    constexpr const T&      operator[](unsigned long i) const noexcept { return elems[i]; }

    // at() asserts bounds via __ESBMC_assert so OOB access surfaces as a
    // property violation instead of a real exception (production code relies
    // on the throw to propagate; we report it as a verification failure).
    constexpr T& at(unsigned long i) noexcept
    {
        __ESBMC_assert(i < N, "std::array::at out of range");
        return elems[i];
    }
    constexpr const T& at(unsigned long i) const noexcept
    {
        __ESBMC_assert(i < N, "std::array::at out of range");
        return elems[i];
    }
};

}  // namespace std
