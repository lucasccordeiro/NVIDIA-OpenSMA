// Minimal <bit> shim for ESBMC verification.
// Tracks: esbmc#4190 (bundled libc++ shim is missing <bit>).
// Provides std::bit_cast (same-size object reinterpretation via byte copy)
// and std::has_single_bit. Sufficient for pdk::mctp::app::Packet and the
// nv::common saturating-arithmetic helpers.
#pragma once
#include <cstddef>
#include <string.h>  // ESBMC's libc provides ::memcpy here

namespace std {

template <typename To, typename From>
constexpr To bit_cast(const From& src) noexcept
{
    static_assert(sizeof(To) == sizeof(From), "bit_cast size mismatch");
    To dst;
    ::memcpy(&dst, &src, sizeof(To));
    return dst;
}

// Minimal std::has_single_bit: true iff x is a power of two.
template <typename T>
constexpr bool has_single_bit(T x) noexcept
{
    return x != 0 && (x & (x - 1)) == 0;
}

}  // namespace std
