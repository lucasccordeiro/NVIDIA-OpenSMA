// ESBMC verification shim for <bit> — full replacement.
//
// ESBMC's bundled <bit> ships a pointer-to-pointer specialisation of
// std::bit_cast that uses reinterpret_cast, but its underlying pointer-
// provenance tracker still loses the parent buffer's bounds across the
// cast: subsequent member-array accesses (e.g., the std::copy_n on
// pkt.ipmi_data inside Ssif::smbus_block_write) report spurious OOB at
// `&ssif + 1` even though the destination is well within the parent
// _buffer member. This is the same root cause as esbmc#4180 part 1
// noted in the c2c_mailbox commit message and worked around in this
// tree via an overlay of pdk-mctp-app-packet.h.
//
// We replace <bit> entirely (gating against the bundled header's
// include guard ESBMC_BIT) so a single std::bit_cast definition lives
// in the TU. Pointer destinations use std::launder + reinterpret_cast,
// which gives ESBMC a fresh provenance assertion that survives downstream
// member-array offsets. Non-pointer destinations defer to
// __builtin_bit_cast for memcpy semantics.
#pragma once
#define ESBMC_BIT 1

#include <type_traits>

namespace std {

// Pointer destinations: route through a void* round-trip then
// reinterpret_cast. The void* pivot pushes ESBMC's pointer-provenance
// tracker into reattaching the new view to the original storage rather
// than retaining a stale single-byte object label. (ESBMC's bundled
// libc++ lacks std::launder, so we rely on the void* trip alone.)
// Non-pointer destinations defer to __builtin_bit_cast for the
// memcpy-semantics path required by [bit.cast].
template<class To, class From>
constexpr To bit_cast(const From& src) noexcept
{
    if constexpr (std::is_pointer_v<To> && std::is_pointer_v<From>) {
        return reinterpret_cast<To>(src);
    }
    else {
        static_assert(sizeof(To) == sizeof(From),
                      "bit_cast requires source and destination to be the same size");
        return __builtin_bit_cast(To, src);
    }
}

}  // namespace std
