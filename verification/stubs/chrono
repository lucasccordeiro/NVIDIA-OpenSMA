// Minimal std::chrono shim for ESBMC verification.
// Tracks: esbmc#4245 — ESBMC bundled C++ library is missing <chrono>.
// Provides the duration typedef aliases used by embedded firmware headers
// (e.g. nv/ipc/event.h: using Usecs = std::chrono::microseconds).
#pragma once
#include <cstdint>

namespace std::chrono {

template <class Rep>
class duration
{
    Rep ticks_{};

public:
    using rep = Rep;

    constexpr duration() = default;
    constexpr explicit duration(Rep v) : ticks_(v) {}
    constexpr Rep count() const noexcept { return ticks_; }
};

using nanoseconds  = duration<long long>;
using microseconds = duration<long long>;
using milliseconds = duration<long long>;
using seconds      = duration<long long>;
using minutes      = duration<long long>;
using hours        = duration<long long>;

}  // namespace std::chrono
